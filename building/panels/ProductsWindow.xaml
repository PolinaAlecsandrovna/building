<Window x:Class="building.panels.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товары — РемонтМаркет" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Calibri" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="12">
            <Button Content="Выход" Width="90" DockPanel.Dock="Left" Click="Exit_Click"/>
            <TextBlock x:Name="UserText" HorizontalAlignment="Right"
                       VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12">
            <ItemsControl x:Name="ProductsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DAA520" BorderThickness="1"
                                Padding="10" Margin="0,0,0,8" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="150" Height="110"
                                        BorderBrush="#B8860B" BorderThickness="1" Background="#FAFAFA">
                                    <Grid>
                                        <TextBlock Text="Фото" Foreground="Gray"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding ImageFile}" Stretch="Uniform"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock FontSize="14" FontWeight="Bold" TextWrapping="Wrap">
                                        <Run Text="{Binding Category}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Name}"/>
                                    </TextBlock>

                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                        <Run Text="Описание товара: "/><Run Text="{Binding Description}"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Производитель: "/><Run Text="{Binding Manufacturer}"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Поставщик: "/><Run Text="{Binding Supplier}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Цена: "/><Run Text="{Binding Price, StringFormat={}{0:N2}}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Единица измерения: "/><Run Text="{Binding Unit}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Количество на складе: "/><Run Text="{Binding Stock}"/>
                                    </TextBlock>
                                </StackPanel>

                                <Border Grid.Column="2" Width="120"
                                        BorderBrush="#B8860B" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasBigDiscount}" Value="True">
                                                    <Setter Property="Background" Value="#FFDAB9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" Margin="6">
                                        <TextBlock Text="Действующая скидка"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding DiscountPercent, StringFormat={}{0:0.##} %}"
                                                   FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>